  {
   "id": 15,
   "type": "row",
   "title": "Model server (vLLM)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 20
   }
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "Requests",
   "description": "Waiting is the signal the autoscaler scales on.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 21
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
