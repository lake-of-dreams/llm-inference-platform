    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(DCGM_FI_PROF_PCIE_TX_BYTES[1m])",
     "legendFormat": "from the GPU",
     "refId": "B"
    }
   ]
  },
