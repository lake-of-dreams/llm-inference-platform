  {
   "id": 12,
   "type": "timeseries",
   "title": "Data moved between CPU and GPU (PCIe)",
   "description": "Large while weights load or a training job feeds batches; small during inference, where tokens are tiny.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 13
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
