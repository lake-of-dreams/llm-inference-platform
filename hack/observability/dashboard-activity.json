   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 21
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
