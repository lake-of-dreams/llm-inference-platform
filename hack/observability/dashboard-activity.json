  {
   "id": 20,
   "type": "timeseries",
   "title": "KV cache in use",
   "description": "The memory holding each conversation's context. Near 100% vLLM starts pausing requests.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
