      "uid": "prometheus"
     },
     "expr": "sum(rate(vllm:generation_tokens_total[1m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Requests running / waiting",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(vllm:num_requests_running) + sum(vllm:num_requests_waiting)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "row",
   "title": "GPU: what the card is doing",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 5
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Utilisation",
   "description": "Decode is limited by memory bandwidth, so that line can be high while Tensor Core activity is low.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "DCGM_FI_DEV_GPU_UTIL_RATIO",
     "legendFormat": "GPU busy",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "DCGM_FI_PROF_TENSOR_UTIL_RATIO",
     "legendFormat": "Tensor Cores",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "DCGM_FI_PROF_GR_ENGINE_UTIL_RATIO",
     "legendFormat": "graphics engine",
     "refId": "C"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "DCGM_FI_PROF_DRAM_UTIL_RATIO",
     "legendFormat": "memory bandwidth",
     "refId": "D"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Memory",
   "description": "vLLM claims its share up front, so this is flat while a model is loaded. A step up is a model loading.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
