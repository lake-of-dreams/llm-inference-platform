  {
   "id": 11,
   "type": "timeseries",
   "title": "Power and temperature",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
