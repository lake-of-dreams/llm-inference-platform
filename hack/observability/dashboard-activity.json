  {
   "id": 18,
   "type": "timeseries",
   "title": "Time to first token",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
